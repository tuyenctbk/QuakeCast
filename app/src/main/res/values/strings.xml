    <!-- Safety Guide Screen -->
    <string name="safety_guide_title">Earthquake Safety Guide</string>
    <string name="safety_subtitle">Critical survival actions endorsed by USGS &amp; FEMA</string>
    <string name="safety_drop_title">1. Drop, Cover, and Hold On</string>
    <string name="safety_drop_desc">DROP to your hands and knees. COVER your head and neck under a sturdy table. HOLD ON until shaking ceases.</string>
    <string name="safety_indoor_title">2. Stay Indoors</string>
    <string name="safety_indoor_desc">Do NOT run outside during active tremors. Most injuries occur from falling debris, glass, and exterior facades.</string>
    <string name="safety_hazard_title">3. Inspect Utilities Post-Tremor</string>
    <string name="safety_hazard_desc">Check for gas leaks and shut off the main valve if gas odor is present. Avoid open flames, matches, or electrical switches.</string>
    <string name="safety_kit_title">4. Emergency Preparedness Go-Bag</string>
    <string name="safety_kit_desc">Maintain 3 days of water (1 gallon/person/day), non-perishable food, flashlight, first aid kit, whistle, and power bank.</string>

