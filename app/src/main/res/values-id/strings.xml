    <!-- Safety Guide Screen -->
    <string name="safety_guide_title">Panduan Keselamatan Gempa Bumi</string>
    <string name="safety_subtitle">Tindakan penyelamatan penting yang didukung USGS &amp; BNPB</string>
    <string name="safety_drop_title">1. Tunduk, Lindungi Kepala, Bertahan</string>
    <string name="safety_drop_desc">MERUNDUK ke lantai. LINDUNGI kepala dan leher di bawah meja kokoh. BERTAHAN sampai guncangan berhenti total.</string>
    <string name="safety_indoor_title">2. Tetap di Dalam Ruangan</string>
    <string name="safety_indoor_desc">JANGAN berlari keluar saat guncangan berlangsung. Sebagian besar cedera disebabkan oleh reruntuhan kaca dan puing fasad luar.</string>
    <string name="safety_hazard_title">3. Periksa Bahaya Instalasi Pascagempa</string>
    <string name="safety_hazard_desc">Periksa kebocoran gas dan tutup katup utama jika tercium bau gas. Hindari menyalakan korek api atau sakelar listrik.</string>
    <string name="safety_kit_title">4. Siapkan Tas Siaga Bencana</string>
    <string name="safety_kit_desc">Sediakan air minum untuk 3 hari (4 liter/orang/hari), makanan tahan lama, senter, kotak P3K, peluit, dan power bank.</string>

